generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth (NextAuth v4 + @auth/prisma-adapter) ──────────────────────────────

enum UserRole {
  ADMIN
  DISPATCHER
  CREW
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CREW)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobsAssigned Job[] @relation("JobCrew")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── CRM ──────────────────────────────────────────────────────────────────

enum CustomerSource {
  GOOGLE_ADS
  REFERRAL
  YELP
  DOOR_HANGER
  WEBSITE
  REPEAT
  OTHER
}

model Customer {
  id                String         @id @default(cuid())
  firstName         String
  lastName          String
  companyName       String?
  email             String?
  phone             String?
  phoneExt          String?
  secondaryPhone    String?
  secondaryPhoneExt String?
  source            CustomerSource @default(OTHER)
  notes             String?        @db.Text

  smsOptIn     Boolean @default(false)
  emailOptIn   Boolean @default(true)
  allowBilling Boolean @default(false)
  taxExempt    Boolean @default(false)

  properties      Property[]
  estimates       Estimate[]
  jobs            Job[]
  invoices        Invoice[]
  communications  Communication[]
  dumpsterRentals DumpsterRental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
}

model Property {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String
  country      String  @default("US")
  latitude     Float?
  longitude    Float?
  notes        String? @db.Text

  estimates       Estimate[]
  jobs            Job[]
  dumpsterRentals DumpsterRental[]

  createdAt DateTime @default(now())
}

// ── Price book ───────────────────────────────────────────────────────────

enum PriceBookItemType {
  SERVICE
  MATERIAL
}

model PriceBookItem {
  id                String            @id @default(cuid())
  number            Int               @unique @default(autoincrement())
  name              String
  description       String?           @db.Text
  type              PriceBookItemType @default(SERVICE)
  category          String?
  modelNumber       String?
  unitPriceCents    Int
  costCents         Int?
  bookable          Boolean           @default(false)
  bookingPriceCents Int?
  active            Boolean           @default(true)

  estimateLineItems EstimateLineItem[]
  invoiceLineItems  InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Estimates / Quoting ─────────────────────────────────────────────────

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
}

model Estimate {
  id         String         @id @default(cuid())
  number     Int            @unique @default(autoincrement())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  propertyId String?
  property   Property?      @relation(fields: [propertyId], references: [id])
  status     EstimateStatus @default(DRAFT)
  notes      String?        @db.Text

  discountCents  Int @default(0)
  depositCents   Int @default(0)
  laborCostCents Int @default(0)

  lineItems       EstimateLineItem[]
  paymentSchedule EstimatePaymentScheduleItem[]
  job             Job?
  invoice         Invoice?
  dumpsterRental  DumpsterRental?
  communications  Communication[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  respondedAt DateTime?
}

model EstimateLineItem {
  id              String         @id @default(cuid())
  estimateId      String
  estimate        Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  priceBookItemId String?
  priceBookItem   PriceBookItem? @relation(fields: [priceBookItemId], references: [id])

  description    String
  quantity       Int    @default(1)
  unitPriceCents Int
  costCents      Int?

  sortOrder Int @default(0)
}

model EstimatePaymentScheduleItem {
  id          String    @id @default(cuid())
  estimateId  String
  estimate    Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  dueDate     DateTime?
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
}

// ── Jobs / Scheduling ────────────────────────────────────────────────────

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Job {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  estimateId String?   @unique
  estimate   Estimate? @relation(fields: [estimateId], references: [id])

  status      JobStatus @default(UNSCHEDULED)
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?   @db.Text

  crew    User[]   @relation("JobCrew")
  invoice Invoice?

  equipmentUsage EquipmentUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Invoicing ────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id               String          @id @default(cuid())
  number           Int             @unique @default(autoincrement())
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  estimateId       String?         @unique
  estimate         Estimate?       @relation(fields: [estimateId], references: [id])
  jobId            String?         @unique
  job              Job?            @relation(fields: [jobId], references: [id])
  dumpsterRentalId String?         @unique
  dumpsterRental   DumpsterRental? @relation(fields: [dumpsterRentalId], references: [id])
  status           InvoiceStatus   @default(DRAFT)

  name        String?
  notes       String?  @db.Text
  invoiceDate DateTime @default(now())
  publicToken String   @unique @default(cuid())

  discountCents  Int     @default(0)
  depositCents   Int     @default(0)
  tipCents       Int     @default(0)
  laborCostCents Int     @default(0)
  taxRateId      String?
  taxRate        TaxRate? @relation(fields: [taxRateId], references: [id])

  lineItems       InvoiceLineItem[]
  payments        Payment[]
  communications  Communication[]
  paymentSchedule InvoicePaymentScheduleItem[]
  attachments     InvoiceAttachment[]
  signature       InvoiceSignature?

  dueAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?
  paidAt    DateTime?
}

model TaxRate {
  id        String    @id @default(cuid())
  name      String
  rateBps   Int
  active    Boolean   @default(true)
  invoices  Invoice[]
  createdAt DateTime  @default(now())
}

model InvoicePaymentScheduleItem {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  dueDate     DateTime?
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())
}

model InvoiceAttachment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  sizeBytes Int
  storageKey String
  createdAt DateTime @default(now())
}

model InvoiceSignature {
  id           String   @id @default(cuid())
  invoiceId    String   @unique
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  signerName   String
  imageDataUrl String   @db.Text
  ipAddress    String?
  signedAt     DateTime @default(now())
}

model InvoiceLineItem {
  id              String         @id @default(cuid())
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  priceBookItemId String?
  priceBookItem   PriceBookItem? @relation(fields: [priceBookItemId], references: [id])

  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  costCents      Int?
  taxable        Boolean @default(false)

  sortOrder Int @default(0)
}

enum PaymentMethod {
  CARD
  CASH
  CHECK
  ACH
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amountCents Int
  method      PaymentMethod
  reference   String?

  createdAt DateTime @default(now())
}

// ── Inventory / Equipment ───────────────────────────────────────────────

model EquipmentItem {
  id               String  @id @default(cuid())
  name             String
  category         String?
  quantityOnHand   Int     @default(0)
  quantityUnit     String  @default("unit")
  reorderThreshold Int?
  notes            String? @db.Text

  usage EquipmentUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EquipmentUsage {
  id              String        @id @default(cuid())
  equipmentItemId String
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id])
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id])
  quantityUsed    Int

  createdAt DateTime @default(now())
}

// ── Dumpster Rentals ────────────────────────────────────────────────────

enum DumpsterUnitStatus {
  AVAILABLE
  OUT
  MAINTENANCE
}

model DumpsterUnit {
  id         String             @id @default(cuid())
  unitNumber String             @unique
  size       String
  status     DumpsterUnitStatus @default(AVAILABLE)
  notes      String?            @db.Text

  rentals DumpsterRental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DumpsterRentalStatus {
  SCHEDULED
  DELIVERED
  PICKED_UP
  CANCELLED
}

model DumpsterRental {
  id             String       @id @default(cuid())
  dumpsterUnitId String
  dumpsterUnit   DumpsterUnit @relation(fields: [dumpsterUnitId], references: [id])
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id])
  estimateId     String?      @unique
  estimate       Estimate?    @relation(fields: [estimateId], references: [id])
  invoice        Invoice?

  status              DumpsterRentalStatus @default(SCHEDULED)
  scheduledDeliveryAt DateTime?
  deliveredAt         DateTime?
  scheduledPickupAt   DateTime?
  pickedUpAt          DateTime?
  notes               String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Communications (email/SMS log — feeds Marketing phase later) ──────────

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

model Communication {
  id         String                 @id @default(cuid())
  customerId String
  customer   Customer               @relation(fields: [customerId], references: [id])
  estimateId String?
  estimate   Estimate?              @relation(fields: [estimateId], references: [id])
  invoiceId  String?
  invoice    Invoice?               @relation(fields: [invoiceId], references: [id])
  channel    CommunicationChannel
  direction  CommunicationDirection
  body       String                 @db.Text
  providerId String?

  createdAt DateTime @default(now())

  @@index([estimateId])
  @@index([invoiceId])
}
