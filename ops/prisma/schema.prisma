generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy / Billing ───────────────────────────────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

model Company {
  id                   String             @id @default(cuid())
  name                 String
  logoDataUrl          String?            @db.Text
  website              String?
  email                String?
  phone                String?
  termsText            String?            @db.Text
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  // IANA zone the business operates in; job times are read/written in it.
  timezone             String             @default("America/New_York")
  // Two-letter US state the business operates in; pre-fills the online booking address.
  state                String?

  users                        User[]
  customers                    Customer[]
  properties                   Property[]
  priceBookItems               PriceBookItem[]
  estimates                    Estimate[]
  estimateLineItems            EstimateLineItem[]
  estimatePaymentScheduleItems EstimatePaymentScheduleItem[]
  jobs                         Job[]
  jobAttachments               JobAttachment[]
  taxRates                     TaxRate[]
  invoices                     Invoice[]
  invoiceLineItems             InvoiceLineItem[]
  invoicePaymentScheduleItems  InvoicePaymentScheduleItem[]
  invoiceAttachments           InvoiceAttachment[]
  invoiceSignatures            InvoiceSignature[]
  payments                     Payment[]
  equipmentItems               EquipmentItem[]
  equipmentUsage               EquipmentUsage[]
  servicePlans                 ServicePlan[]
  servicePlanSubscriptions     ServicePlanSubscription[]
  communications               Communication[]
  vendors                      Vendor[]
  purchaseOrders               PurchaseOrder[]
  purchaseOrderLineItems       PurchaseOrderLineItem[]
  purchaseOrderAttachments     PurchaseOrderAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Auth (NextAuth v4 + @auth/prisma-adapter) ──────────────────────────────

enum UserRole {
  ADMIN
  DISPATCHER
  CREW
}

model User {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CREW)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobsAssigned Job[] @relation("JobCrew")

  purchaseOrdersRequested PurchaseOrder[]

  @@index([companyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── CRM ──────────────────────────────────────────────────────────────────

enum CustomerSource {
  GOOGLE_ADS
  REFERRAL
  YELP
  DOOR_HANGER
  WEBSITE
  REPEAT
  OTHER
}

model Customer {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  firstName         String
  lastName          String
  companyName       String?
  email             String?
  phone             String?
  phoneExt          String?
  secondaryPhone    String?
  secondaryPhoneExt String?
  source            CustomerSource @default(OTHER)
  notes             String?        @db.Text

  smsOptIn     Boolean @default(false)
  // Set when the customer replies STOP to a text; blocks further outbound SMS.
  smsOptedOut  Boolean @default(false)
  emailOptIn   Boolean @default(true)
  allowBilling Boolean @default(false)
  taxExempt    Boolean @default(false)

  stripeCustomerId String?

  properties               Property[]
  estimates                Estimate[]
  jobs                     Job[]
  invoices                 Invoice[]
  communications           Communication[]
  servicePlanSubscriptions ServicePlanSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, lastName, firstName])
}

model Property {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String
  country      String  @default("US")
  latitude     Float?
  longitude    Float?
  notes        String? @db.Text

  estimates                Estimate[]
  jobs                     Job[]
  servicePlanSubscriptions ServicePlanSubscription[]

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ── Price book ───────────────────────────────────────────────────────────

enum PriceBookItemType {
  SERVICE
  MATERIAL
  RENTAL
}

model PriceBookItem {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  number            Int               @unique @default(autoincrement())
  name              String
  description       String?           @db.Text
  type              PriceBookItemType @default(SERVICE)
  category          String?
  modelNumber       String?
  unitPriceCents    Int
  costCents         Int?
  bookable          Boolean           @default(false)
  bookingPriceCents Int?
  active            Boolean           @default(true)

  estimateLineItems EstimateLineItem[]
  invoiceLineItems  InvoiceLineItem[]
  servicePlans      ServicePlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// ── Estimates / Quoting ─────────────────────────────────────────────────

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
}

model Estimate {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id])
  number     Int            @unique @default(autoincrement())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  propertyId String?
  property   Property?      @relation(fields: [propertyId], references: [id])
  status     EstimateStatus @default(DRAFT)
  notes      String?        @db.Text
  jobId      String?
  job        Job?           @relation(fields: [jobId], references: [id])

  discountCents  Int @default(0)
  depositCents   Int @default(0)
  laborCostCents Int @default(0)

  lineItems       EstimateLineItem[]
  paymentSchedule EstimatePaymentScheduleItem[]
  invoice         Invoice?
  communications  Communication[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  respondedAt DateTime?

  // Customer e-signature via the public /e/[token] page.
  publicToken      String?   @unique
  signedName       String?
  signatureDataUrl String?   @db.Text
  signedAt         DateTime?
  signedIp         String?

  @@index([companyId])
  @@index([jobId])
}

model EstimateLineItem {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  estimateId      String
  estimate        Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  priceBookItemId String?
  priceBookItem   PriceBookItem? @relation(fields: [priceBookItemId], references: [id])

  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  costCents      Int?
  // Rental items are priced per day; quantity is then the number of days.
  isRental       Boolean @default(false)

  sortOrder Int @default(0)

  @@index([companyId])
}

model EstimatePaymentScheduleItem {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  estimateId  String
  estimate    Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  dueDate     DateTime?
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ── Jobs / Scheduling ────────────────────────────────────────────────────

enum JobStatus {
  UNSCHEDULED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Job {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  status      JobStatus @default(UNSCHEDULED)
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?   @db.Text

  crew      User[]     @relation("JobCrew")
  estimates Estimate[]
  invoices  Invoice[]

  equipmentUsage         EquipmentUsage[]
  attachments            JobAttachment[]
  purchaseOrderLineItems PurchaseOrderLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model JobAttachment {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  dataUrl   String   @db.Text
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([jobId])
}

// ── Invoicing ────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id                        String                   @id @default(cuid())
  companyId                 String
  company                   Company                  @relation(fields: [companyId], references: [id])
  number                    Int                      @unique @default(autoincrement())
  customerId                String
  customer                  Customer                 @relation(fields: [customerId], references: [id])
  estimateId                String?                  @unique
  estimate                  Estimate?                @relation(fields: [estimateId], references: [id])
  jobId                     String?
  job                       Job?                     @relation(fields: [jobId], references: [id])
  servicePlanSubscriptionId String?
  servicePlanSubscription   ServicePlanSubscription? @relation(fields: [servicePlanSubscriptionId], references: [id])
  status                    InvoiceStatus            @default(DRAFT)

  name        String?
  notes       String?  @db.Text
  invoiceDate DateTime @default(now())
  publicToken String   @unique @default(cuid())

  discountCents  Int      @default(0)
  depositCents   Int      @default(0)
  tipCents       Int      @default(0)
  laborCostCents Int      @default(0)
  taxRateId      String?
  taxRate        TaxRate? @relation(fields: [taxRateId], references: [id])

  lineItems       InvoiceLineItem[]
  payments        Payment[]
  communications  Communication[]
  paymentSchedule InvoicePaymentScheduleItem[]
  attachments     InvoiceAttachment[]
  signature       InvoiceSignature?

  dueAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?
  paidAt    DateTime?

  @@index([companyId])
  @@index([jobId])
  @@index([servicePlanSubscriptionId])
}

model TaxRate {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  rateBps   Int
  active    Boolean   @default(true)
  // The company's current sales tax rate (set in Settings); at most one per company.
  isDefault Boolean   @default(false)
  invoices  Invoice[]
  createdAt DateTime  @default(now())

  @@index([companyId])
}

model InvoicePaymentScheduleItem {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  dueDate     DateTime?
  sortOrder   Int       @default(0)

  createdAt DateTime @default(now())

  @@index([companyId])
}

model InvoiceAttachment {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime @default(now())

  @@index([companyId])
}

model InvoiceSignature {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  invoiceId    String   @unique
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  signerName   String
  imageDataUrl String   @db.Text
  ipAddress    String?
  signedAt     DateTime @default(now())

  @@index([companyId])
}

model InvoiceLineItem {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  invoiceId       String
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  priceBookItemId String?
  priceBookItem   PriceBookItem? @relation(fields: [priceBookItemId], references: [id])

  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  costCents      Int?
  taxable        Boolean @default(false)
  isRental       Boolean @default(false)

  sortOrder Int @default(0)

  @@index([companyId])
}

enum PaymentMethod {
  CARD
  CASH
  CHECK
  ACH
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amountCents Int
  method      PaymentMethod
  reference   String?

  stripePaymentIntentId String? @unique
  stripeInvoiceId       String? @unique

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ── Inventory / Equipment ───────────────────────────────────────────────

model EquipmentItem {
  id               String  @id @default(cuid())
  companyId        String
  company          Company @relation(fields: [companyId], references: [id])
  name             String
  category         String?
  quantityOnHand   Int     @default(0)
  quantityUnit     String  @default("unit")
  reorderThreshold Int?
  notes            String? @db.Text

  usage EquipmentUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model EquipmentUsage {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  equipmentItemId String
  equipmentItem   EquipmentItem @relation(fields: [equipmentItemId], references: [id])
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id])
  quantityUsed    Int

  createdAt DateTime @default(now())

  @@index([companyId])
}

// ── Service Plans (recurring subscriptions) ────────────────────────────────

enum ServicePlanDurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum ServicePlanBillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum ServicePlanSubscriptionStatus {
  DRAFT
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model ServicePlan {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id])
  name            String
  scopeOfWork     String?                 @db.Text
  durationValue   Int
  durationUnit    ServicePlanDurationUnit
  autoRenew       Boolean                 @default(true)
  visitsPerPeriod Int
  jobTypeId       String?
  jobType         PriceBookItem?          @relation(fields: [jobTypeId], references: [id])
  priceCents      Int
  archived        Boolean                 @default(false)
  stripeProductId String?

  billingOptions ServicePlanBillingOption[]
  subscriptions  ServicePlanSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model ServicePlanBillingOption {
  id              String                      @id @default(cuid())
  servicePlanId   String
  servicePlan     ServicePlan                 @relation(fields: [servicePlanId], references: [id], onDelete: Cascade)
  frequency       ServicePlanBillingFrequency
  discountPercent Int?
  amountCents     Int
  stripePriceId   String?
  sortOrder       Int                         @default(0)

  subscriptions ServicePlanSubscription[]

  @@index([servicePlanId])
}

model ServicePlanSubscription {
  id              String                        @id @default(cuid())
  companyId       String
  company         Company                       @relation(fields: [companyId], references: [id])
  servicePlanId   String
  servicePlan     ServicePlan                   @relation(fields: [servicePlanId], references: [id])
  billingOptionId String
  billingOption   ServicePlanBillingOption      @relation(fields: [billingOptionId], references: [id])
  customerId      String
  customer        Customer                      @relation(fields: [customerId], references: [id])
  propertyId      String?
  property        Property?                     @relation(fields: [propertyId], references: [id])
  status          ServicePlanSubscriptionStatus @default(DRAFT)

  priceCentsSnapshot Int
  visitsTotal        Int
  visitsUsed         Int       @default(0)
  startDate          DateTime?
  endDate            DateTime?
  nextVisitDate      DateTime?

  stripeCustomerId        String?
  stripeSubscriptionId    String? @unique
  stripeCheckoutSessionId String?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
}

// ── Communications (email/SMS log — feeds Marketing phase later) ──────────

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationDirection {
  OUTBOUND
  INBOUND
}

model Communication {
  id         String                 @id @default(cuid())
  companyId  String
  company    Company                @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer               @relation(fields: [customerId], references: [id])
  estimateId String?
  estimate   Estimate?              @relation(fields: [estimateId], references: [id])
  invoiceId  String?
  invoice    Invoice?               @relation(fields: [invoiceId], references: [id])
  channel    CommunicationChannel
  direction  CommunicationDirection
  body       String                 @db.Text
  providerId String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([estimateId])
  @@index([invoiceId])
}

// ── Purchase Orders ────────────────────────────────────────────────────────

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum PurchaseOrderFulfillment {
  DELIVERY
  PICKUP
}

model Vendor {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name           String
  addressLine1   String?
  city           String?
  state          String?
  zip            String?
  phone          String?
  phoneExt       String?
  secondaryPhone String?
  email          String?
  secondaryEmail String?
  contactName    String?
  contactTitle   String?
  paymentTerms   String?
  active         Boolean @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())

  @@index([companyId])
}

model PurchaseOrder {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  number        Int     @unique @default(autoincrement())
  vendorId      String
  vendor        Vendor  @relation(fields: [vendorId], references: [id])
  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id])

  status               PurchaseOrderStatus      @default(DRAFT)
  orderDate            DateTime                 @default(now())
  fulfillment          PurchaseOrderFulfillment @default(DELIVERY)
  expectedDate         DateTime?
  deliveryAddressLine1 String?
  deliveryCity         String?
  deliveryState        String?
  deliveryZip          String?
  notes                String?                  @db.Text
  sentAt               DateTime?
  receivedAt           DateTime?
  // Lets the vendor download the PO PDF from the email without an account.
  publicToken          String?                  @unique

  lineItems   PurchaseOrderLineItem[]
  attachments PurchaseOrderAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([vendorId])
}

model PurchaseOrderLineItem {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  jobId           String?
  job             Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)

  name      String
  costCents Int
  quantity  Int    @default(1)
  sortOrder Int    @default(0)

  @@index([companyId])
  @@index([purchaseOrderId])
}

model PurchaseOrderAttachment {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  filename        String
  mimeType        String
  dataUrl         String        @db.Text
  createdAt       DateTime      @default(now())

  @@index([companyId])
  @@index([purchaseOrderId])
}
