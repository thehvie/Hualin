# Copy to .env and fill in real values. .env is gitignored.

DATABASE_URL="postgresql://postgres:password@localhost:5432/haulin_ops_dev"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -hex 32"

# Mailgun (reuse the account already used by the marketing site).
# MAILGUN_FROM_EMAIL is shared across all tenants for now — the sending
# domain isn't per-tenant yet, only the display name (Company.name) is.
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM_EMAIL=""

# Twilio (SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Optional: send with a Twilio API Key (SK...) instead of the account Auth Token.
# TWILIO_ACCOUNT_SID (AC...) is still required as the account identifier, and
# TWILIO_AUTH_TOKEN is still required to verify inbound webhook signatures.
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""

# GitHub webhook auto-deploy — generate with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=""

# Google Maps (client-side map widget + server-side geocoding).
# Public by design (restrict via HTTP referrer in Google Cloud Console, not secrecy).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Stripe (SaaS subscription billing — signup checkout + webhook).
# STRIPE_WEBHOOK_SECRET comes from registering /api/stripe/webhook as an
# endpoint in the Stripe Dashboard (or `stripe listen` locally).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STANDARD=""

# Stripe (Service Plans — a tenant company billing ITS OWN customers for
# recurring service plans). Same Stripe account/secret key as above, but a
# separate webhook endpoint/secret: register
# /api/stripe/service-plans/webhook as its own endpoint in the Stripe
# Dashboard (or a second `stripe listen` process locally) so this domain
# never gets confused with the SaaS's own tenant billing above.
STRIPE_SERVICE_PLAN_WEBHOOK_SECRET=""
