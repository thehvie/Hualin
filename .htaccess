Options -Indexes

RewriteEngine On

# Redirect www to non-www (live domain only)
RewriteCond %{HTTP_HOST} ^www\.haulinjunkies\.com [NC]
RewriteRule ^ https://haulinjunkies.com%{REQUEST_URI} [R=301,L]

# Force HTTPS (live domain only)
RewriteCond %{HTTP_HOST} ^haulinjunkies\.com [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://haulinjunkies.com%{REQUEST_URI} [R=301,L]

# Redirect /index.php to / (all environments)
RewriteCond %{THE_REQUEST} /index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# Legacy .html URLs → .php equivalents (old site version still indexed by Google)
RewriteCond %{REQUEST_URI} ^/(.+)\.html$
RewriteRule ^(.+)\.html$ /$1.php [R=301,L]

# Custom 404 error page
ErrorDocument 404 /404.php

# Underscore URL fixes
Redirect 301 /apartment_cleanouts.php /apartment-cleanouts.php
Redirect 301 /estate_cleanout.php /estate-cleanout.php

# orlando.php → homepage (was cannibalizing index.php for "junk removal orlando")
Redirect 301 /orlando.php /

